{
  "id": "news",
  "version": 8,
  "enforcement": "strict",
  "roots": {
    "home": "[data-news-module=\"home\"]",
    "archive": "[data-news-module=\"archive\"]",
    "adminHealth": "[data-news-health-admin]",
    "adminGameLinks": "[data-news-game-review-admin]"
  },
  "runtime": [
    "features/news/shared/translations-ru.js",
    "features/news/content-api/index.js",
    "features/news/shared/index.js",
    "features/news/home-widget/index.js",
    "features/news/shared/archive-facade-v2.js",
    "features/news/archive-page/model.js",
    "features/news/archive-page/index.js",
    "features/news/admin-health/index.js",
    "features/news/admin-game-links/index.js",
    "features/news/styles/index.css"
  ],
  "contentApi": {
    "global": "IgropoiskNewsContent",
    "version": 2,
    "interface": [
      "getAll",
      "getArchive",
      "getHome",
      "health",
      "invalidate"
    ],
    "backend": "yandex-object-storage-compact-live-plus-monthly-archive-with-repository-fallback",
    "manifest": "https://storage.yandexcloud.net/igropoisk-content/news/manifests/current.json"
  },
  "pipeline": {
    "config": "config/news-pipeline.json",
    "workflow": ".github/workflows/news-pipeline.yml",
    "orchestrator": "scripts/run-news-pipeline.mjs",
    "publicationGate": "scripts/validate-news-pipeline.mjs",
    "publisher": "scripts/publish-news-storage.mjs",
    "storageClient": "scripts/lib/yandex-object-storage.mjs",
    "healthBuilder": "scripts/build-news-pipeline-health.mjs",
    "health": "data/news-pipeline-health.json",
    "test": "scripts/test-news-pipeline.mjs",
    "archiveTest": "scripts/test-news-archive.mjs",
    "gameLinkTest": "scripts/test-news-game-linker.mjs",
    "healthTest": "scripts/test-news-pipeline-health.mjs",
    "schedule": "hourly-with-per-source-cadence",
    "publication": "compact-live-snapshot-plus-stable-monthly-archive-with-atomic-manifest"
  },
  "content": [
    "data/news-events.json",
    "data/news.json",
    "data/publisher-news.json",
    "data/youtube-signals.json",
    "data/news-home-ru.json",
    "data/news-game-review.json",
    "data/news-game-aliases.json",
    "data/news-game-overrides.json",
    "data/news-pipeline-health.json",
    "assets/news/",
    "assets/publisher-news/"
  ],
  "centralComponents": [
    "ig-card",
    "ig-card--interactive",
    "ig-card__media",
    "ig-card__body",
    "ig-card__meta",
    "ig-card__title",
    "ig-card__summary",
    "ig-button",
    "ig-icon-button",
    "ig-input",
    "ig-filter-chip",
    "ig-chip",
    "ig-hashtag",
    "ig-chip-list",
    "ig-toolbar",
    "ig-panel",
    "ig-empty-state",
    "ig-page-title"
  ],
  "designSystem": {
    "source": "assets/design-system.css",
    "policy": "central-components-only",
    "localStyles": "composition-only"
  }
}
