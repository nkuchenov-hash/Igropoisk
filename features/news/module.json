{
  "id": "news",
  "version": 1,
  "enforcement": "strict",
  "roots": {
    "home": "[data-news-module=\"home\"]",
    "archive": "[data-news-module=\"archive\"]"
  },
  "runtime": [
    "features/news/shared/translations-ru.js",
    "features/news/shared/index.js",
    "features/news/home-widget/index.js",
    "features/news/archive-page/index.js",
    "features/news/styles/index.css"
  ],
  "content": [
    "data/news-events.json",
    "data/news.json",
    "data/publisher-news.json",
    "data/news-home-ru.json",
    "assets/news/",
    "assets/publisher-news/"
  ],
  "centralComponents": [
    "ig-card",
    "ig-card--interactive",
    "ig-card__media",
    "ig-card__body",
    "ig-card__meta",
    "ig-card__title",
    "ig-card__summary",
    "ig-button",
    "ig-icon-button",
    "ig-input",
    "ig-filter-chip",
    "ig-chip",
    "ig-chip-list",
    "ig-toolbar",
    "ig-empty-state",
    "ig-page-title"
  ],
  "designSystem": {
    "source": "assets/design-system.css",
    "policy": "central-components-only",
    "localStyles": "composition-only"
  }
}
