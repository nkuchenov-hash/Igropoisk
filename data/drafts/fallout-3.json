      "recommended": {
        "raw": "<strong>Recommended:</strong>                    <br>\t\t\t\t\t<ul class=\"bb_ul\"><li><strong>Operating system: </strong>Windows XP/Vista                    <br>\t\t\t\t\t</li><li><strong>Processor: </strong>Intel Core 2 Duo processor                     <br>\t\t\t\t\t</li><li><strong>Memory: </strong>2 GB System RAM                     <br>\t\t\t\t\t</li><li><strong>Hard disk space: </strong>7 GB                    <br>\t\t\t\t\t</li><li><strong>Video: </strong>Direct X 9.0c compliant video card with 512MB RAM (NVIDIA 8800 series, ATI 3800 series)                     <br>\t\t\t\t\t</li><li><strong>Sound: </strong>DirectX®: 9.0c                    <br>\t\t\t\t\t</li><li><strong>Controller support: </strong> Xbox 360 controller                    </li></ul>"
