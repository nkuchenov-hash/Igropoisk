DATABASE_URL=postgresql://igropoisk:change-me@postgres:5432/igropoisk
PGSSL_MODE=disable
CONTENT_RUNTIME_MODE=shadow
CONTENT_READ_SOURCE=object_storage
SHADOW_WRITE_ENABLED=false
MAX_SYNC_AGE_SECONDS=3600
ALLOWED_ORIGINS=https://nkuchenov-hash.github.io
HOST=0.0.0.0
PORT=8080
SHUTDOWN_GRACE_MS=10000
SERVICE_VERSION=local-shadow
NEWS_MANIFEST_URL=https://storage.yandexcloud.net/igropoisk-content/news/manifests/current.json
SNAPSHOT_ALLOWED_HOSTS=storage.yandexcloud.net
SNAPSHOT_FETCH_TIMEOUT_MS=15000
MANIFEST_MAX_BYTES=256000
SNAPSHOT_MAX_BYTES=25000000
NEWS_SHADOW_SYNC_REPORT=
