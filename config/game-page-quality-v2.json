{
  "schema_version": 2,
  "review_corpus": {
    "minimum_sources": 5,
    "target_sources": 20,
    "maximum_sources": 20,
    "candidate_target": 36,
    "minimum_contemporary_modern": 5,
    "minimum_contemporary_historical": 4,
    "forbidden_title_or_url_terms": ["walkthrough", "guide", "wiki", "tips", "build", "builds", "news", "preview", "interview", "how-to", "howto", "攻略", "прохождение", "гайд", "советы", "новости", "превью", "интервью"],
    "forbidden_domains": ["store.steampowered.com", "steamcommunity.com", "metacritic.com", "opencritic.com", "reddit.com", "youtube.com", "youtu.be", "fandom.com"],
    "regional_discovery": {
      "required_region": "ru",
      "must_check_all_configured_modern_sources": true,
      "accepted_statuses": ["found", "not_found", "unavailable"]
    }
  },
  "review_score": {
    "owner": "review",
    "minimum_sources": 3,
    "target_sources": 10,
    "maximum_sources": 20,
    "method": "arithmetic_mean",
    "output_scale": 10,
    "rounding_decimals": 1,
    "one_vote_per_publication": true,
    "aggregators_forbidden": true,
    "invented_scores_forbidden": true,
    "letter_grade_map": {"A+":10,"A":9.5,"A-":9,"B+":8.5,"B":8,"B-":7.5,"C+":7,"C":6.5,"C-":6,"D+":5.5,"D":5,"D-":4.5,"F":2.5}
  },
  "editorial_language": {
    "language": "ru",
    "minimum_natural_russian": 0.8,
    "minimum_editorial_voice": 0.8,
    "minimum_source_grounding": 0.8,
    "reject_translationese": true,
    "reject_generic_ai_filler": true
  },
  "images": {
    "modern_year_floor": 2010,
    "hero": {"minimum_width_modern":1200,"minimum_height_modern":675,"minimum_width_historical":960,"minimum_height_historical":540,"minimum_bytes":80000},
    "cover": {"minimum_width_modern":600,"minimum_height_modern":850,"minimum_width_historical":400,"minimum_height_historical":560,"minimum_bytes":45000},
    "screenshot": {"minimum_width_modern":1280,"minimum_height_modern":720,"minimum_width_historical":800,"minimum_height_historical":600,"minimum_bytes":70000,"minimum_count":6},
    "reject_visible_upscale": true,
    "reject_blur": true,
    "reject_heavy_compression": true,
    "reject_stretching": true,
    "hero_must_not_be_screenshot": true,
    "official_art_required": true
  },
  "similarity": {
    "minimum_score": 0.34,
    "maximum_results": 12,
    "series_weight": 0.05,
    "series_requires_other_similarity": true,
    "weights": {"genres":0.16,"subgenres":0.1,"gameplay_type":0.08,"combat":0.09,"perspective":0.05,"world_structure":0.07,"party_mode":0.06,"narrative":0.08,"progression":0.07,"setting":0.05,"tone":0.04,"multiplayer":0.04,"mechanics":0.08,"semantic_tokens":0.08}
  },
  "quality_loop": {"immediate_revision_attempts":4,"keep_queued_until_green":true,"terminal_quality_status_forbidden":true}
}
