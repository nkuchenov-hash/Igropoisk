{
  "schema_version": 3,
  "timezone": "UTC",
  "schedule_cron": "23 * * * *",
  "groups": [
    {
      "id": "global-media",
      "interval_minutes": 1440,
      "freshness_file": "data/news.json",
      "commands": [
        "node scripts/fetch-news.mjs",
        "node scripts/collect-regional-news.mjs",
        "node scripts/postprocess-industry-news.mjs"
      ]
    },
    {
      "id": "official-sources",
      "interval_minutes": 60,
      "freshness_file": "data/publisher-news.json",
      "commands": [
        "node scripts/fetch-publisher-news.mjs",
        "node scripts/fetch-youtube-signals.mjs"
      ]
    }
  ],
  "rebuild_commands": [
    "node scripts/build-news-events.mjs",
    "node scripts/build-home-news.mjs"
  ],
  "health": {
    "output_file": "data/news-pipeline-health.json",
    "command": "node scripts/build-news-pipeline-health.mjs",
    "persistent_failure_threshold": 3,
    "warning_age_minutes": {
      "data/news.json": 2160,
      "data/publisher-news.json": 120,
      "data/youtube-signals.json": 120,
      "data/news-events.json": 120,
      "data/news-home-ru.json": 120
    },
    "blocking_age_minutes": {
      "data/news.json": 4320,
      "data/publisher-news.json": 360,
      "data/youtube-signals.json": 360,
      "data/news-events.json": 360,
      "data/news-home-ru.json": 360
    }
  },
  "publication": {
    "required_files": [
      "data/news.json",
      "data/publisher-news.json",
      "data/youtube-signals.json",
      "data/news-events.json",
      "data/news-home-ru.json",
      "data/news-pipeline-health.json"
    ],
    "commit_paths": [
      "data/news.json",
      "data/publisher-news.json",
      "data/youtube-signals.json",
      "data/news-events.json",
      "data/news-home-ru.json",
      "data/news-pipeline-health.json",
      "assets/news",
      "assets/publisher-news"
    ],
    "minimum_items": {
      "data/news.json": 12,
      "data/publisher-news.json": 1,
      "data/news-events.json": 12,
      "data/news-home-ru.json": 12
    },
    "minimum_retained_fraction": 0.25,
    "homepage_exact_items": 12,
    "minimum_official_source_success_ratio": 0.15,
    "image_roots": [
      "assets/news/",
      "assets/publisher-news/"
    ],
    "storage": {
      "provider": "yandex-object-storage",
      "current_manifest": "news/manifests/current.json",
      "snapshot_prefix": "news/snapshots",
      "media_prefix": "news/media",
      "maximum_snapshot_bytes": 25000000,
      "immutable_cache_control": "public, max-age=31536000, immutable",
      "manifest_cache_control": "no-store, max-age=0"
    }
  }
}
