{
  "schema_version": 3,
  "popular": {
    "maximum_snapshot_age_hours": 12,
    "minimum_cards": 20,
    "primary": {
      "minimum_confidence": 0.55,
      "minimum_score": 4,
      "minimum_independent_families": 2
    },
    "direct_demand": {
      "enabled": true,
      "maximum_steam_position": 15,
      "minimum_confidence": 0.5,
      "minimum_score": 10
    },
    "secondary": {
      "enabled": true,
      "minimum_confidence": 0.48,
      "minimum_score": 2,
      "maximum_steam_position": 45,
      "minimum_independent_evidence": 1,
      "allowed_independent_families": ["news", "youtube", "reddit", "twitch"],
      "fresh_signal_hours": 96
    },
    "evergreen_requires_fresh_non_steam_signal_unless_top_demand": true
  },
  "releases": {
    "recent_days": 7,
    "homepage_limit": 24,
    "exclude_title_patterns": [
      "\\bdemo\\b",
      "\\bprologue\\b",
      "\\bplaytest\\b",
      "\\btest server\\b",
      "\\bbenchmark\\b",
      "\\bsoundtrack\\b",
      "\\bartbook\\b",
      "\\bdedicated server\\b"
    ],
    "duplicate_suffix_patterns": [
      "\\s*[™®]$",
      "\\s*[-:]?\\s*(demo|prologue|playtest)$"
    ],
    "significant_genres": ["Action", "Adventure", "RPG", "Strategy", "Simulation", "Fighting", "Файтинг"],
    "minimum_homepage_quality": 3
  }
}
