{
  "schema_version": 13,
  "purpose": "Собирать небольшой осмысленный визуальный ряд обзора: несколько каруселей из реально полезных кадров, а не заполнять картинкой каждый раздел.",
  "responsibility_boundary": {
    "design_system_is_only_layout_source": true,
    "builder_may_not_define_layout": true,
    "builder_may_not_override_layout_tokens": true,
    "builder_may_not_emit_inline_layout_styles": true,
    "builder_may_not_choose_column_widths": true,
    "builder_may_not_choose_card_dimensions": true,
    "builder_only_populates_named_content_slots": true,
    "content_slots": ["article_hero_art", "article_title", "article_dek", "article_metadata", "article_lead", "article_sections", "article_section_media", "article_verdict", "article_sources", "article_author"]
  },
  "article_balance": {
    "minimum_words": 1600,
    "target_words": 2200,
    "maximum_words_without_editor_approval": 3200,
    "minimum_words_per_section": 170,
    "minimum_sections": 7,
    "target_sections": 8,
    "maximum_sections": 9,
    "minimum_candidate_screenshots": 7,
    "target_candidate_screenshots": 10,
    "minimum_approved_screenshots": 6,
    "minimum_total_screenshots": 6,
    "minimum_unique_screenshots": 6,
    "screenshots_per_section": {"minimum": 0, "target": 0, "maximum": 4},
    "carousel_policy": {
      "minimum_carousels": 2,
      "target_carousels": 3,
      "maximum_carousels": 3,
      "minimum_images_per_carousel": 2,
      "target_images_per_carousel": 3,
      "maximum_images_per_carousel": 4
    }
  },
  "hero_policy": {
    "required": true,
    "allowed_kinds": ["official_key_art", "official_artwork", "promotional_art", "official_store_art"],
    "forbidden_kinds": ["thumbnail", "logo_only", "cover_crop"],
    "must_be_game_specific": true,
    "must_pass_visual_audit": true,
    "must_have_safe_text_zone": false,
    "reject_visible_upscale": true,
    "reject_soft_resampling": true,
    "reject_muddy_contrast": true,
    "reject_bad_crop": true
  },
  "media_content_policy": {
    "minimum_images_per_carousel": 2,
    "target_images_per_carousel": 3,
    "maximum_images_per_carousel": 4,
    "captions_required": true,
    "carousel_commentary_required": true,
    "visible_subject_required": true,
    "source_attribution_required": true,
    "alt_text_required": true,
    "builder_outputs_content_only": true,
    "design_system_renders_carousel": true,
    "design_system_controls_card_size": true,
    "design_system_controls_image_fit": true,
    "design_system_controls_responsive_behavior": true
  },
  "source_policy": {
    "minimum_media_sources": 1,
    "maximum_share_from_one_source": 1,
    "prefer_official_game_specific_media": true,
    "single_official_source_allowed_when_verified": true
  },
  "discovery_policy": {
    "independent_from_text_sources": true,
    "continue_search_until_every_section_is_filled": false,
    "stop_when_useful_carousel_pool_is_ready": true,
    "provider_order": ["official_store", "official_galleries", "press_kits", "game_databases", "editorial_galleries"],
    "minimum_search_rounds": 0,
    "maximum_search_rounds_before_hard_error": 4,
    "expand_queries_after_each_round": true,
    "search_queries_per_game_minimum": 2,
    "search_result_pages_per_query": 1,
    "include_title_variants": true,
    "include_original_language_title": true,
    "include_platform_and_year_queries": true,
    "include_section_specific_queries": false,
    "follow_thumbnail_to_original": true,
    "download_and_measure_every_candidate": true,
    "never_trust_declared_dimensions": true,
    "never_reuse_text_source_limit_as_media_source_limit": true
  },
  "quality_gate": {
    "minimum_width_modern": 480,
    "minimum_height_modern": 270,
    "minimum_width_historical": 480,
    "minimum_height_historical": 270,
    "minimum_bytes_modern": 25000,
    "minimum_bytes_historical": 25000,
    "maximum_download_bytes": 25000000,
    "minimum_aspect_ratio": 0.75,
    "maximum_aspect_ratio": 2.6,
    "target_render_width_source": "design_system_token",
    "resolution_is_only_technical_floor": true,
    "allow_clean_small_originals": true,
    "require_known_dimensions": true,
    "require_image_mime_type": true,
    "require_successful_download": true,
    "reject_thumbnail": true,
    "reject_visible_upscale": true,
    "reject_soft_resampling": true,
    "reject_heavy_jpeg_artifacts": true,
    "reject_blur": true,
    "reject_muddy_contrast": true,
    "reject_stretched_aspect_ratio": true,
    "reject_ugly_or_unusable_composition": true,
    "reject_excessive_empty_canvas": true,
    "reject_tiny_subject_inside_large_canvas": true,
    "reject_watermark_dominating_image": true,
    "reject_wrong_game_version": true,
    "reject_duplicate_url": true,
    "reject_duplicate_scene": true,
    "reject_near_duplicate_crop": true,
    "reject_reuse_across_carousels": true,
    "visual_quality_confidence": 0.78,
    "minimum_sharpness": 0.72,
    "minimum_compression_quality": 0.7,
    "minimum_readability": 0.68,
    "minimum_composition_quality": 0.68,
    "minimum_render_suitability": 0.72,
    "semantic_relevance_confidence": 0.78
  },
  "deduplication_policy": {
    "canonical_url_unique": true,
    "content_hash_unique": true,
    "perceptual_hash_unique": true,
    "duplicate_group_unique": true,
    "scene_embedding_unique": false,
    "near_duplicate_threshold": 0.92,
    "same_scene_different_crop_forbidden": true,
    "reuse_across_carousels_forbidden": true
  },
  "publication_gate": {
    "fail_closed": true,
    "html_generation_requires_content_pass": true,
    "deployment_requires_content_pass": true,
    "missing_audit_is_failure": true,
    "missing_hero_art_is_failure": true,
    "missing_one_image_in_any_section_is_failure": false,
    "minimum_meaningful_carousels_required": 2,
    "any_duplicate_is_failure": true,
    "layout_validation_belongs_to_design_system": true,
    "content_validator_must_not_validate_layout_dimensions": true
  },
  "publication_invariants": [
    "Обзор содержит 2–3 осмысленные карусели, а не обязательную одиночную картинку в каждом разделе.",
    "Каждая карусель содержит 2–4 разных кадра и ставится только рядом с тезисом, которому визуальный ряд действительно помогает.",
    "Vision-аудит подписывает конкретно видимое содержимое каждого кадра и объясняет его связь с игрой; пустые универсальные подписи запрещены.",
    "Официальный Steam/CDN или press-kit предпочитается случайным поисковым изображениям: правильность игры важнее количества источников картинок.",
    "Ни один URL или визуально совпадающая сцена не повторяется между каруселями.",
    "Если проверенных кадров недостаточно для двух осмысленных каруселей, visual upgrade блокируется, но быстрый текстовый обзор остаётся опубликованным.",
    "Сборщик не создаёт сетку, не задаёт размеры и не пишет inline layout CSS; он только заполняет именованные слоты дизайн-системы."
  ]
}
