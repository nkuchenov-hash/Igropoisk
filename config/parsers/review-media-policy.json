{
  "schema_version": 4,
  "purpose": "Создавать полноценные редакционные обзоры: содержательный текст и большой набор качественных, неповторяющихся скриншотов, которые поясняют конкретные тезисы статьи.",
  "article_balance": {
    "minimum_words": 1800,
    "target_words": 2300,
    "maximum_words_without_editor_approval": 3200,
    "minimum_words_per_section": 180,
    "target_words_per_section": 240,
    "minimum_sections": 8,
    "maximum_sections": 10,
    "minimum_candidate_screenshots": 30,
    "minimum_approved_screenshots": 24,
    "minimum_total_screenshots": 18,
    "minimum_unique_screenshots": 18,
    "screenshots_per_section": {
      "minimum": 2,
      "target": 3,
      "maximum": 5
    }
  },
  "card_behavior": {
    "one_card_per_section": true,
    "horizontal_carousel_inside_card": true,
    "desktop_arrows": true,
    "mobile_swipe": true,
    "counter": true,
    "dots": true,
    "caption_changes_with_slide": true,
    "source_changes_with_slide": true
  },
  "quality_gate": {
    "minimum_width_modern": 1280,
    "minimum_height_modern": 720,
    "minimum_width_historical": 1024,
    "minimum_height_historical": 576,
    "require_known_dimensions": true,
    "allow_640x480_only_when_unique_evidence": false,
    "reject_thumbnail": true,
    "reject_visible_upscale": true,
    "reject_heavy_jpeg_artifacts": true,
    "reject_blur": true,
    "reject_wrong_game_version": true,
    "reject_duplicate_url": true,
    "reject_duplicate_scene": true,
    "reject_reuse_across_sections": true,
    "visual_quality_confidence": 0.82,
    "semantic_relevance_confidence": 0.8
  },
  "source_policy": {
    "minimum_media_sources": 3,
    "prefer_official_press_kits": true,
    "allow_editorial_full_resolution_archives": true,
    "allow_historical_archives": true,
    "forbid_single_source_media_set": true,
    "store_source_url_and_resolution_for_every_image": true
  },
  "caption_policy": {
    "minimum_sentences": 1,
    "must_explain_visible_detail": true,
    "must_connect_detail_to_section_claim": true,
    "forbid_generic_caption": true
  },
  "publication_invariants": [
    "Количество уникальных URL обязано совпадать с общим количеством кадров статьи.",
    "Один duplicate_group может быть использован не более одного раза во всей статье.",
    "Кадр без известной ширины и высоты не может попасть в опубликованный обзор.",
    "Скриншоты не заменяют анализ: статья и каждый её раздел проходят отдельный текстовый gate.",
    "Нарушение любого правила блокирует генерацию HTML и публикацию обзора."
  ]
}
