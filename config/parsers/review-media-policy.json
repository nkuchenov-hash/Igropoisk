{
  "schema_version": 8,
  "purpose": "Создавать полноценные журнальные обзоры: подробный текст, широкая адаптивная вёрстка и большой набор визуально качественных уникальных скриншотов с осмысленными комментариями.",
  "article_balance": {
    "minimum_words": 2200,
    "target_words": 2800,
    "maximum_words_without_editor_approval": 4200,
    "minimum_words_per_section": 220,
    "minimum_sections": 8,
    "target_sections": 10,
    "maximum_sections": 12,
    "minimum_candidate_screenshots": 80,
    "target_candidate_screenshots": 120,
    "minimum_approved_screenshots": 40,
    "minimum_total_screenshots": 30,
    "minimum_unique_screenshots": 30,
    "screenshots_per_section": {"minimum":3,"target":4,"maximum":6}
  },
  "layout_policy": {
    "desktop_three_column_layout": true,
    "left_sticky_table_of_contents": true,
    "center_reading_column_min_width": 760,
    "center_reading_column_max_width": 980,
    "right_sticky_metadata_rail": true,
    "maximum_page_width": 1600,
    "media_cards_match_reading_column_width": true,
    "collapse_sidebars_below_px": 1180,
    "single_column_below_px": 760
  },
  "card_behavior": {
    "one_or_more_cards_per_section": true,
    "horizontal_carousel_inside_card": true,
    "desktop_arrows": true,
    "keyboard_navigation": true,
    "mobile_swipe": true,
    "counter": true,
    "dots": true,
    "caption_changes_with_slide": true,
    "source_changes_with_slide": true,
    "preload_next_image": true,
    "progressive_enhancement": true
  },
  "discovery_policy": {
    "use_web_image_search": true,
    "search_queries_per_game_minimum": 8,
    "search_result_pages_per_query": 3,
    "include_game_title_variants": true,
    "include_original_language_title": true,
    "include_platform_and_year_queries": true,
    "include_gameplay_city_combat_character_vehicle_interface_queries": true,
    "crawl_editorial_article_galleries": true,
    "crawl_official_press_kits": true,
    "crawl_store_galleries": true,
    "crawl_historical_archives": true,
    "follow_thumbnail_to_original": true,
    "store_candidate_origin_page": true,
    "store_direct_image_url": true,
    "download_and_measure_every_candidate": true,
    "never_trust_declared_dimensions": true
  },
  "quality_gate": {
    "minimum_width_modern": 480,
    "minimum_height_modern": 480,
    "minimum_width_historical": 480,
    "minimum_height_historical": 480,
    "minimum_bytes_modern": 25000,
    "minimum_bytes_historical": 25000,
    "maximum_download_bytes": 25000000,
    "minimum_aspect_ratio": 0.75,
    "maximum_aspect_ratio": 2.6,
    "target_render_width_desktop": 1000,
    "resolution_is_only_technical_floor": true,
    "allow_clean_small_originals": true,
    "require_known_dimensions": true,
    "require_image_mime_type": true,
    "require_successful_download": true,
    "reject_thumbnail": true,
    "reject_visible_upscale": true,
    "reject_soft_resampling": true,
    "reject_heavy_jpeg_artifacts": true,
    "reject_blur": true,
    "reject_muddy_contrast": true,
    "reject_stretched_aspect_ratio": true,
    "reject_ugly_or_unusable_composition": true,
    "reject_watermark_dominating_image": true,
    "reject_wrong_game_version": true,
    "reject_duplicate_url": true,
    "reject_duplicate_scene": true,
    "reject_near_duplicate_crop": true,
    "reject_reuse_across_sections": true,
    "visual_quality_confidence": 0.92,
    "minimum_sharpness": 0.82,
    "minimum_compression_quality": 0.78,
    "minimum_readability": 0.72,
    "minimum_composition_quality": 0.76,
    "minimum_render_suitability": 0.84,
    "semantic_relevance_confidence": 0.86
  },
  "source_policy": {
    "minimum_media_sources": 5,
    "target_media_sources": 8,
    "prefer_official_press_kits": true,
    "allow_editorial_full_resolution_archives": true,
    "allow_historical_archives": true,
    "allow_search_discovered_original_files": true,
    "forbid_single_source_media_set": true,
    "maximum_share_from_one_source": 0.35,
    "store_source_url_and_resolution_for_every_image": true
  },
  "caption_policy": {
    "minimum_sentences": 1,
    "must_explain_visible_detail": true,
    "must_connect_detail_to_section_claim": true,
    "forbid_generic_caption": true,
    "forbid_repeating_section_text": true
  },
  "content_policy": {
    "screenshots_supplement_not_replace_text": true,
    "require_table_of_contents": true,
    "require_lead": true,
    "require_verdict": true,
    "require_best_for_and_not_for": true,
    "require_source_list": true,
    "require_return_to_game_top_and_bottom": true
  },
  "publication_invariants": [
    "Разрешение используется только как технический нижний предел и не считается показателем качества.",
    "Чистый оригинальный кадр 600×600 может пройти, если он визуально резкий, не растянут и пригоден для фактического размера показа.",
    "Большой файл отклоняется, если он размыт, искусственно увеличен, пережат, растянут, визуально грязен или композиционно непригоден.",
    "Каждый кандидат оценивается с учётом целевого размера показа в карточке статьи, а не только собственных пикселей.",
    "Кадр без confidence, sharpness, compression, readability, composition и render suitability либо с любым показателем ниже порога блокирует публикацию.",
    "Количество уникальных URL обязано совпадать с общим количеством кадров статьи.",
    "Один duplicate_group может быть использован не более одного раза во всей статье.",
    "Скриншоты не заменяют анализ: статья и каждый её раздел проходят отдельный текстовый gate.",
    "Нарушение любого правила блокирует генерацию HTML и публикацию обзора."
  ]
}
