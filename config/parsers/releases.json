{
  "schema_version": 2,
  "horizon_days": 540,
  "steam_discovery_limit": 100,
  "publication_discovery_horizon_days": 180,
  "publication_discovery_timeout_ms": 18000,
  "download_images": true,
  "seed_steam_appids": [],
  "publication_source_registry": "config/parsers/review-source-registry.json",
  "official_source_registry": "config/parsers/official-source-registry.json",
  "source_registry_enforcement": {
    "publication_registry_required": true,
    "official_registry_required": true,
    "official_check_plan_required": true,
    "missing_applicable_official_check": "report_and_review"
  },
  "source_priorities": {
    "official_site": 100,
    "official_store": 90,
    "igdb": 80,
    "rawg": 55,
    "media_calendar": 30
  },
  "date_rules": {
    "accepted_precisions": ["exact", "month", "quarter", "year", "tbd"],
    "never_invent_exact_day": true,
    "separate_platform_and_region_events": true,
    "preserve_history": true,
    "official_conflict_requires_review": true
  },
  "image_rules": {
    "preferred_width": 600,
    "preferred_height": 900,
    "minimum_bytes": 15000,
    "allowed_content_types": ["image/jpeg", "image/png", "image/webp", "image/avif"],
    "allow_remote_fallback": true,
    "reject_watermarks": true,
    "reject_media_thumbnails": true,
    "reject_fan_art": true,
    "reject_ai_generated_substitutes": true
  },
  "editorial_rules": {
    "create_draft": true,
    "auto_publish": false,
    "preserve_locked_fields": true,
    "minimum_draft_fields": ["title", "event", "platforms", "source", "image"]
  }
}
