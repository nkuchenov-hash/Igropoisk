{
  "schema_version": 1,
  "timezone": "UTC",
  "default_interval_minutes": 60,
  "parsers": [
    {
      "id": "popular",
      "enabled": true,
      "interval_minutes": 360,
      "quota_policy": {
        "mode": "free_tier_safe",
        "youtube_method": "videos.list",
        "youtube_regions_per_run": 6,
        "youtube_calls_per_run": 6,
        "maximum_scheduled_runs_per_day": 4,
        "estimated_youtube_units_per_day": 24
      },
      "publication_policy": {
        "require_verified_cover_for_every_game": true,
        "keep_previous_ranking_on_cover_failure": true,
        "allow_placeholders": false
      },
      "command": "node scripts/parse-popular.mjs && node scripts/filter-popular.mjs && node scripts/resolve-popular-covers.mjs",
      "outputs": [
        "data/popular/current.json",
        "data/popular/covers.json",
        "data/parser-runs/popular.json",
        "assets/covers/popular"
      ]
    }
  ]
}
