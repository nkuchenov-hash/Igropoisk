{
  "schema_version": 2,
  "timezone": "UTC",
  "default_interval_minutes": 60,
  "parsers": [
    {
      "id": "popular",
      "enabled": true,
      "interval_minutes": 360,
      "quota_policy": {
        "mode": "free_tier_safe",
        "youtube_methods": ["videos.list", "search.list"],
        "youtube_regions_per_run": 6,
        "global_candidate_searches_per_run": 12,
        "maximum_scheduled_runs_per_day": 4,
        "estimated_youtube_units_per_day": 4824
      },
      "publication_policy": {
        "require_verified_cover_for_every_published_game": true,
        "keep_previous_cards_when_sources_temporarily_degrade": true,
        "allow_placeholders": false,
        "block_on_exact_cardinality": false
      },
      "command": "node scripts/test-gta6-popular-rules.mjs && node scripts/parse-popular.mjs && node scripts/enrich-global-popular-youtube.mjs && node scripts/filter-popular.mjs && node scripts/resolve-popular-covers.mjs && node scripts/resolve-global-popular-art.mjs && node scripts/resolve-official-popular-packages.mjs && node scripts/canonicalize-system-game-identity.mjs --popular-only --write",
      "outputs": [
        "data/popular/current.json",
        "data/popular/covers.json",
        "data/parser-runs/popular.json",
        "assets/covers/popular"
      ]
    },
    {
      "id": "releases",
      "enabled": true,
      "interval_minutes": 360,
      "publication_policy": {
        "create_page_drafts": true,
        "auto_publish": false,
        "preserve_editor_locked_fields": true,
        "official_conflicts_require_review": true
      },
      "command": "node scripts/parse-releases.mjs && node scripts/normalize-release-feed.mjs",
      "outputs": [
        "data/releases/current.json",
        "data/releases/changes.json",
        "data/parser-runs/releases.json",
        "data/release-drafts",
        "assets/covers/releases"
      ]
    }
  ]
}
