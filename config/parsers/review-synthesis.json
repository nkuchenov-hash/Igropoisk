{
  "schema_version": 8,
  "id": "review-synthesis",
  "title": "Review Skill v1 — Игропоиск",
  "status": "active",
  "schedule": "После обновления канонического пакета источников, данных игры или медиакорпуса",
  "purpose": "Собирать evergreen-журнальные обзоры конкретной игры из канонического source pack Game Page Module без собственного поиска источников, шаблонной структуры и временных редакционных штампов.",
  "canonical_source_contract": {
    "path": "data/game-sources/{slug}.json",
    "owner": "game-page-source-pipeline",
    "review_module_discovers_sources": false,
    "source_count_policy": "use_all_available_verified_sources",
    "fixed_editorial_source_quota": null,
    "sources_define_evidence_not_structure": true
  },
  "model_policy": {
    "owner": "single_model_per_review_task",
    "same_model_attempts": 3,
    "cross_model_fallback": false,
    "technical_failure_policy": "retry_same_assigned_model"
  },
  "publication_gate": {
    "minimum_sections": 7,
    "maximum_sections": 9,
    "minimum_article_words": 1600,
    "target_article_words": 2200,
    "maximum_article_words_without_editor_approval": 3200,
    "minimum_words_per_section": 170,
    "publish_below_editorial_qc": false
  },
  "editorial_workflow": [
    {
      "pass": "evidence_extraction",
      "goal": "Извлечь подтверждённые механики, сильные стороны, проблемы, спорные моменты, исторический контекст, интерфейсные решения и запоминающиеся конкретные детали."
    },
    {
      "pass": "editorial_angle_and_structure",
      "goal": "Определить характер игры, главный редакционный угол и структуру, которая возникает из самой игры, а не из универсального шаблона."
    },
    {
      "pass": "draft",
      "goal": "Написать цельный журнальный текст, органично связывая доказательства, конкретные детали, достоинства и недостатки."
    },
    {
      "pass": "anti_generic_evergreen_audit",
      "goal": "Убрать временные привязки, AI-формулировки, шаблонные разделы, искусственные выводы и проверить, не пропущены ли характерные детали и интерфейсная обратная связь."
    }
  ],
  "editorial_policy": {
    "evergreen": true,
    "dynamic_game_specific_structure": true,
    "headings_must_identify_aspect": true,
    "encyclopedic_intro": false,
    "required_ageing_section": false,
    "required_modern_suitability_section": false,
    "historical_context_only_when_explanatory": true,
    "mechanics_use_present_tense": true,
    "characteristic_details_are_high_priority": true,
    "interface_feedback_pass_required": true,
    "interface_feedback_topics": [
      "HUD",
      "карта",
      "индикаторы здоровья",
      "инвентарь",
      "сохранения",
      "управление",
      "звуковые сигналы"
    ],
    "weaknesses_discussed_in_relevant_system_context": true,
    "separate_cons_section_required": false,
    "select_material_by_game_character": true,
    "material_selection_question": "Помогает ли эта деталь понять, почему именно эта игра такая?",
    "sources_define_evidence_not_structure": true,
    "public_best_for_not_for_checklist": false,
    "authorial_verdict": true,
    "finale_is_not_section_summary": true,
    "finale_should_leave_aftertaste": true,
    "evergreen_blacklist": [
      "игрово",
      "состарилось плохо",
      "состарилась плохо",
      "выдаёт свой возраст",
      "сегодня ощущается",
      "по нынешним меркам",
      "по современным меркам",
      "по современным стандартам",
      "для современного игрока",
      "современному игроку",
      "положенное на рельсы путешествие"
    ]
  },
  "media_quality_policy": {
    "policy_file": "config/parsers/review-media-policy.json"
  },
  "outputs": [
    "data/article-drafts/{slug}.json",
    "data/articles/{slug}.json",
    "data/parser-runs/review-synthesis-{slug}.json"
  ]
}
