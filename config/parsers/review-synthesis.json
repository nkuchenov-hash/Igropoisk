    "title": "Mafia: The City of Lost Heaven",
    "article_json": "data/articles/mafia.json",
    "article_page": "article/mafia/index.html",
    "rule": "Mafia: The City of Lost Heaven является единственным эталонным инструментом и структурным образцом для новых обзоров. Другие готовые обзоры, включая The Witcher 3, не используются как шаблон структуры, голоса, инструментов страницы или редакционного контракта."
  },
  "schedule": "После обновления данных игры, рейтинга или медиакорпуса",
  "purpose": "Собирать полноценные редакционные обзоры по эталону Mafia: The City of Lost Heaven: исследование по независимым профессиональным источникам, разбор конкретной игры, визуально насыщенная страница и строгий publication gate.",
  "publication_gate": {
    "editorial_reviews_required": 20,
    "independent_publications_required": 20,
    "minimum_sections": 8,
    "maximum_sections": 10,
    "minimum_article_words": 2200,
    "target_article_words": 2600,
    "maximum_article_words_without_editor_approval": 3800,
    "media_candidates_required": 30,
    "media_candidates_quality_passed_required": 18,
    "independent_media_sources_required": 3,
    "minimum_total_article_images": 30,
    "minimum_unique_article_images": 30,
    "minimum_images_per_section": 3,
    "target_images_per_section": 3,
    "maximum_images_per_section": 5,
    "publish_below_gate": false
  },
  "research_policy": {
    "candidate_target": 36,
    "historical_before_year": 2010,
    "historical_minimum_contemporary": 12,
    "modern_minimum_contemporary": 16,
    "allow_professional_retrospectives": true,
    "allow_port_reviews_for_platform_context": true,
    "allow_source_expansion": true,
    "resolve_dead_links_with_internet_archive": true,
    "url_timeout_ms": 15000,
    "source_corpus_expanded_at": "2026-08-08T22:07:00Z",
    "source_expansion_rule": "Professional editorial outlets may be added when they carry a substantive review of the exact game; regional mirrors of the same publication do not count as independent publications."
  },
  "editorial_voice": {
    "base": "analytical, concrete, readable, non-promotional",
    "irony": "light",
    "irony_rule": "Допустима лёгкая ирония и сухой юмор в отдельных формулировках, когда они усиливают наблюдение. Не превращать обзор в стендап, мемный текст или поток шуток. Юмор не должен подменять аргумент, факты или критику.",
    "spoiler_rule": "Не раскрывать крупные сюжетные повороты без явной необходимости и предупреждения.",
    "balance_rule": "Разбирать достоинства, недостатки, ограничения, устаревшие решения и современную пригодность игры, а не писать рекламный текст.",
    "specificity_rule": "Каждый раздел должен объяснять конкретные механики, решения, ощущения игрока и последствия этих решений; избегать универсальных фраз, которые подошли бы любой игре."
  },
  "media_quality_policy": {
    "policy_file": "config/parsers/review-media-policy.json",
