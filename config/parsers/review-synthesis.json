{
  "schema_version": 5,
  "id": "review-synthesis",
  "title": "Конструктор обзоров Игропоиска",
  "status": "active",
  "schedule": "После обновления данных игры, рейтинга или медиакорпуса",
  "purpose": "Собирать цельные визуально насыщенные обзоры: меньше повторяющегося текста, больше качественных скриншотов с осмысленными комментариями.",
  "publication_gate": {
    "editorial_reviews_required": 20,
    "independent_publications_required": 20,
    "minimum_sections": 7,
    "maximum_sections": 9,
    "minimum_article_words": 1300,
    "target_article_words": 1600,
    "maximum_article_words_without_editor_approval": 2200,
    "media_candidates_required": 30,
    "media_candidates_quality_passed_required": 18,
    "independent_media_sources_required": 3,
    "minimum_total_article_images": 18,
    "minimum_unique_article_images": 12,
    "minimum_images_per_section": 2,
    "target_images_per_section": 3,
    "maximum_images_per_section": 5,
    "publish_below_gate": false
  },
  "research_policy": {
    "candidate_target": 36,
    "historical_before_year": 2010,
    "historical_minimum_contemporary": 12,
    "modern_minimum_contemporary": 16,
    "allow_professional_retrospectives": true,
    "allow_port_reviews_for_platform_context": true,
    "allow_source_expansion": true,
    "resolve_dead_links_with_internet_archive": true,
    "url_timeout_ms": 15000
  },
  "media_quality_policy": {
    "policy_file": "config/parsers/review-media-policy.json",
    "minimum_candidates": 30,
    "minimum_approved_candidates": 18,
    "minimum_media_sources": 3,
    "minimum_total_article_images": 18,
    "minimum_unique_article_images": 12,
    "minimum_images_per_section": 2,
    "target_images_per_section": 3,
    "maximum_images_per_section": 5,
    "minimum_quality_confidence": 0.78,
    "minimum_semantic_confidence": 0.78,
    "reject_single_source_media_set": true,
    "reject_thumbnails": true,
    "reject_blur": true,
    "reject_heavy_compression": true,
    "reject_visible_upscale": true,
    "reject_wrong_game_version": true,
    "reject_duplicate_scene": true
  },
  "method": {
    "formula": "20 источников критики + 30 медиакандидатов из 3+ источников → фильтр качества → план 7–9 разделов → обзор 1300–2200 слов → 2–5 кадров в каждой карточке → vision-аудит → публикация.",
    "normalization": "Текстовые и медиa-источники учитываются отдельно. Официальные страницы, магазины, агрегаторы и пользовательские отзывы не заменяют 20 профессиональных обзоров. Один медиa-источник не может формировать весь визуальный ряд статьи.",
    "steps": [
      "Точно определить игру, год, разработчика, платформу и исключённые версии.",
      "Найти и проверить не менее 20 независимых профессиональных обзоров.",
      "Собрать минимум 30 скриншотов-кандидатов как минимум из трёх независимых медиa-источников.",
      "Для каждого изображения сохранить URL, источник, разрешение, версию игры, визуальные теги и хеш сцены.",
      "Отклонить миниатюры, размытые, пережатые, искусственно увеличенные изображения, дубли и кадры другой версии игры.",
      "Оставить минимум 18 качественных кандидатов и минимум 12 различных сцен.",
      "Построить динамический план из 7–9 разделов по конкретной игре.",
      "Написать 1300–2200 содержательных слов без повторов и искусственного растягивания.",
      "Создать одну карточку скриншотов на каждый раздел и поместить внутрь неё 2–5 релевантных кадров.",
      "Для каждого кадра написать отдельный комментарий: что видно и как это подтверждает тезис раздела.",
      "Проверить каждый кадр моделью зрения по качеству и смысловому соответствию.",
      "Показать внутри карточки стрелки, свайп, счётчик, точки, меняющуюся подпись и ссылку на источник.",
      "Связать существенные тезисы с проверенными source_id и вывести источники в конце статьи.",
      "Заблокировать публикацию при нехватке текста, источников, качественных кадров, разных сцен или медиa-источников."
    ],
    "article_structure": [
      "Hero с названием, тезисом, оценкой и временем чтения.",
      "Короткий lead без рекламных формулировок.",
      "Оглавление из 7–9 разделов.",
      "Каждый раздел содержит компактный разбор и одну карточку с 2–5 прокручиваемыми скриншотами.",
      "Каждый скриншот имеет самостоятельную содержательную подпись и ссылку на источник.",
      "Отдельный вердикт: кому игра подходит и кому нет.",
      "Удобный возврат к странице игры сверху и в конце обзора.",
      "Полный список реально использованных источников в конце статьи."
    ]
  },
