{
  "schema_version": 2,
  "model": "publication-registry-media-panel-v2",
  "source_registry": "config/parsers/review-source-registry.json",
  "required_release_role": "coverage",
  "coverage_window_days": 180,
  "research_candidate_limit": 120,
  "rules": {
    "one_point_per_publisher_family": true,
    "no_intersection_count_cap": true,
    "store_and_official_sources_do_not_count": true,
    "regional_sources_also_count_toward_global_intersection": true,
    "coverage_requires_substantive_editorial_material": true,
    "inline_source_records_forbidden": true
  }
}
