{
  "schema_version": 2,
  "id": "content-pipeline",
  "title": "Контентный оркестратор Игропоиска",
  "status": "active",
  "purpose": "Координировать независимые контентные процессы: создание и обновление страниц игр, а также отдельную review/editorial-подсистему. Совместный запуск не означает принадлежность обзоров модулю страницы игры.",
  "module_boundaries": {
    "game_page_module": {
      "owns": ["game identity", "game facts", "game media", "relations", "similarity data", "page quality", "shared page rendering", "page publication"],
      "must_not_require": ["published editorial review", "review corpus", "review synthesis"],
      "may_consume": ["published review", "review score", "news", "guides", "other related content"]
    },
    "review_editorial_subsystem": {
      "owns": ["professional review discovery", "review corpus", "review scoring", "editorial review synthesis", "review quality", "review publication"],
      "links_to_page_by": ["canonical game_id", "slug"]
    }
  },
  "execution_limits": {
    "pages_per_run": 2,
    "reviews_per_run": 1
  },
  "page_gate": {
    "minimum_identity_sources": 2,
    "minimum_sources": 10,
    "minimum_features": 4,
    "minimum_screenshots": 6,
    "require_official_video_when_available": true,
    "require_published_review": false,
    "publish_below_gate": false
  },
  "review_gate": {
    "policy_file": "config/parsers/review-synthesis.json",
    "independent_from_page_publication": true,
    "publish_below_gate": false
  },
  "refresh_cadence_days": {
    "upcoming_release": 1,
    "recent_release": 7,
    "live_service": 7,
    "published_page": 90,
    "published_review": 180
  },
  "priority": {
    "upcoming_release": 80,
    "recent_release": 40,
    "release_calendar_origin": 25,
    "missing_page": 70,
    "missing_review": 60
  },
  "outputs": [
    "data/content-pipeline/registry.json",
    "data/content-pipeline/queue.json",
    "data/content-pipeline/status.json",
    "data/content-pipeline/execution-plan.json",
    "data/content-pipeline/execution-log.json",
    "data/parser-runs/content-pipeline.json"
  ]
}
