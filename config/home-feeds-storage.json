{
  "schema_version": 1,
  "channel": "home-feeds",
  "required_files": [
    "data/popular/current.json",
    "data/popular/published.json",
    "data/releases/current.json",
    "data/releases/public.json",
    "data/releases/changes.json"
  ],
  "runtime_files": [
    "data/popular/current.json",
    "data/releases/current.json",
    "data/releases/public.json"
  ],
  "media_roots": [
    "assets/covers/popular/",
    "assets/covers/releases/"
  ],
  "storage": {
    "current_manifest": "home-feeds/manifests/current.json",
    "snapshot_prefix": "home-feeds/snapshots",
    "media_prefix": "home-feeds/media",
    "maximum_snapshot_bytes": 50000000,
    "immutable_cache_control": "public, max-age=31536000, immutable",
    "manifest_cache_control": "no-store, max-age=0"
  }
}
